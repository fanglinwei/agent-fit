      "explainSelection": "export function explainSelection({ definition, level, role = 'task_delegate' }) {\n  if (!LEVELS.includes(level) || !Object.hasOwn(ROLES, role)) throw argumentError('任务等级或角色无效。');\n  const { model, effort, fallback } = definition.levels[level];\n  const fixed = ROLES[role] && definition.levels[ROLES[role]];\n  const matches = level !== 'L4' && fixed && fixed.model === model && fixed.effort === effort;\n  return {\n    mode_id: definition.id, mode_kind: definition.kind, mode_name: definition.name,\n    level, level_source: 'argument', requested_role: role, dispatch_role: matches ? role : 'task_delegate',\n    primary: { model, effort }, fallback, fallback_conditions: fallback ? FALLBACK_CONDITIONS : [],\n    permission_contract: { task_scan: 'readonly_evidence', task_execute: 'scoped_output', task_review: 'readonly_review', task_delegate: 'bounded_delegate' }[role],\n    reason_codes: ['TASK_LEVEL_ARGUMENT', 'MODE_PRESET', matches ? 'FIXED_ROLE_MATCH' : 'UNPINNED_ROLE_REQUIRED', 'MODEL_ACCESS_UNKNOWN', 'RUNTIME_UNVERIFIED'],\n    verification: verificationRequirement(definition), access: 'unknown', runtime_verification: 'unverified',\n  };\n}",
      "role_contract_projection": "const roles = Object.entries(ROLES).map(([name, level]) => {\n    const relative = `agents/${name.replaceAll('_', '-')}.toml`, source = path.join(home, relative);\n    const bytes = observedFiles.get(relative).bytes;\n    let role = null;\n    try { if (bytes !== null) role = parseConfig(bytes, source); } catch {}\n    const expected = level && mode?.levels[level];\n    const matches = mode ? role !== null && role.name === name && (expected ? role.model === expected.model && role.model_reasoning_effort === expected.effort : !Object.hasOwn(role, 'model') && !Object.hasOwn(role, 'model_reasoning_effort')) : null;\n    if (state && !matches) diagnostics.push(diagnostic('ROLE_CONTRACT_MISMATCH', 'fail', source, `角色 ${name} 的名称、模型或推理强度与当前档位职责不一致；缺失或无效文件也不能满足职责。`));\n    return { name, task_level: level, source, managed: !!state?.files[relative], configured_name: safeText(role?.name), configured_model: safeText(role?.model), configured_effort: safeText(role?.model_reasoning_effort), expected_model: expected?.model ?? null, expected_effort: expected?.effort ?? null, matches_mode: matches, availability: { status: 'unknown', source: null }, fallback_candidates: expected?.fallback ? [expected.fallback] : [] };\n  });"
    },
